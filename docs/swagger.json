{
  "swagger": "2.0",
  "info": {
    "title": "ERP Management API",
    "description": "ERP后台接口文档，当前包含认证系统与客户管理模块。",
    "version": "1.0"
  },
  "basePath": "/api/v1",
  "schemes": ["http", "https"],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  },
  "paths": {
    "/dashboard/boss": {
      "get": {
        "tags": ["老板驾驶舱"],
        "summary": "老板驾驶舱经营数据",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "success" } }
      }
    },
    "/customers": {
      "get": {
        "tags": ["客户管理"],
        "summary": "客户分页列表",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "type": "integer" },
          { "name": "pageSize", "in": "query", "type": "integer" },
          { "name": "keyword", "in": "query", "type": "string" }
        ],
        "responses": { "200": { "description": "success" } }
      },
      "post": {
        "tags": ["客户管理"],
        "summary": "创建客户",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "body", "in": "body", "schema": { "$ref": "#/definitions/CustomerRequest" } }],
        "responses": { "201": { "description": "success" } }
      }
    },
    "/customers/export": {
      "get": {
        "tags": ["客户管理"],
        "summary": "导出客户Excel",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "keyword", "in": "query", "type": "string" }],
        "responses": { "200": { "description": "Excel文件" } }
      }
    },
    "/customers/import": {
      "post": {
        "tags": ["客户管理"],
        "summary": "导入客户Excel",
        "security": [{ "BearerAuth": [] }],
        "consumes": ["multipart/form-data"],
        "parameters": [{ "name": "file", "in": "formData", "type": "file", "required": true }],
        "responses": { "200": { "description": "success" } }
      }
    },
    "/customers/{id}": {
      "get": {
        "tags": ["客户管理"],
        "summary": "客户详情",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "type": "integer", "required": true }],
        "responses": { "200": { "description": "success" } }
      },
      "put": {
        "tags": ["客户管理"],
        "summary": "更新客户",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "type": "integer", "required": true },
          { "name": "body", "in": "body", "schema": { "$ref": "#/definitions/CustomerRequest" } }
        ],
        "responses": { "200": { "description": "success" } }
      },
      "delete": {
        "tags": ["客户管理"],
        "summary": "删除客户",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "type": "integer", "required": true }],
        "responses": { "200": { "description": "success" } }
      }
    },
    "/customers/{id}/debt": {
      "get": {
        "tags": ["客户管理"],
        "summary": "客户欠款",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "type": "integer", "required": true }],
        "responses": { "200": { "description": "success" } }
      }
    },
    "/customers/{id}/orders": {
      "get": {
        "tags": ["客户管理"],
        "summary": "客户历史订单",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "type": "integer", "required": true },
          { "name": "page", "in": "query", "type": "integer" },
          { "name": "pageSize", "in": "query", "type": "integer" }
        ],
        "responses": { "200": { "description": "success" } }
      }
    }
  },
  "definitions": {
    "CustomerRequest": {
      "type": "object",
      "required": ["code", "name"],
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "level": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "taxNo": { "type": "string" },
        "address": { "type": "string" },
        "creditLimit": { "type": "number" },
        "receivableBalance": { "type": "number" },
        "status": { "type": "string" },
        "remark": { "type": "string" }
      }
    }
  }
}
